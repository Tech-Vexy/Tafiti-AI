# ==============================================================================
# Tafiti AI - Backend Environment Variables
# Stack: Supabase/Neon PostgreSQL, Upstash Redis, Google AI / Nvidia NIM / OpenRouter, Resend Email
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment
# ------------------------------------------------------------------------------
APP_NAME="Research Assistant API"
VERSION="2.0.0"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security & JWT (Fallback / Internal verification)
SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (Next.js App Router)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Authentication (Clerk JWKS Verification)
# ------------------------------------------------------------------------------
# The backend does NOT need Clerk secret keys or SDK.
# It only needs CLERK_DOMAIN to fetch public JWKS keys and verify incoming bearer tokens from the frontend.
# E.g. "clerk.app.tafitiai.co.ke" or "verbose-anteater-42.clerk.accounts.dev"
CLERK_DOMAIN=your_clerk_domain_here

# Comma-separated or JSON list of emails granted admin privileges on first login
# ADMIN_EMAILS=["admin@tafitiai.co.ke"]

# ------------------------------------------------------------------------------
# 3. Database (Supabase PostgreSQL / Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase Connection Pooler (Port 5432 session mode or 6543 transaction mode - Recommended for IPv4):
DATABASE_URL=postgresql+asyncpg://postgres.lcscppuqfrazlmueybfd:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?ssl=require

# Direct connection (IPv6 only):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.lcscppuqfrazlmueybfd.supabase.co:5432/postgres

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# ------------------------------------------------------------------------------
# 4. Redis & Celery (Upstash Redis)
# ------------------------------------------------------------------------------
# Upstash provides secure TLS Redis URLs starting with rediss://
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
CACHE_TTL=3600
CELERY_BROKER_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379/2

# ------------------------------------------------------------------------------
# 5. LLM Providers & Routing (Google AI, Nvidia NIM, OpenRouter)
# ------------------------------------------------------------------------------
# Primary Default Provider: "gemini", "nvidia", or "openrouter"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Pydantic AI Multi-Agent Routing (Drafter & Critic - OpenRouter)
DRAFTER_MODEL=openrouter:openrouter/free
CRITIC_MODEL=openrouter:openrouter/free

# Google AI (Gemini Studio API Key - Gemini 3.x Series: gemini-3.1, gemini-3.5, gemini-3.6, gemini-3.8)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-pro

# Gemini Deep Research agent (Interactions API, preview)
# https://ai.google.dev/gemini-api/docs/deep-research
# default; set engine="gemini-max" or GEMINI_DEEP_RESEARCH_MAX_AGENT for Deep Research Max
GEMINI_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
GEMINI_DEEP_RESEARCH_MAX_AGENT=deep-research-max-preview-04-2026
GEMINI_DEEP_RESEARCH_THINKING_SUMMARIES=none
GEMINI_DEEP_RESEARCH_VISUALIZATION=auto
GEMINI_DEEP_RESEARCH_COLLABORATIVE_PLANNING=false

# Nvidia NIM (API Key: https://build.nvidia.com | Base URL: https://integrate.api.nvidia.com/v1)
# Supported models:
# - deepseek-ai/deepseek-v4-flash-0731 (fast reasoning)
# - deepseek-ai/deepseek-v4-pro-0813 (pro reasoning)
# - moonshotai/kimi-k3 (multimodal / vision & max reasoning)
# - poolside/laguna-xs-2.1 (fast code / math)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=deepseek-ai/deepseek-v4-flash-0731

# OpenRouter (https://openrouter.ai/keys | Free models: https://openrouter.ai/models?variant=free)
# Examples of active free models:
# - openrouter/free (auto-routed free model)
# - google/gemma-4-31b-it:free
# - google/gemma-4-26b-a4b-it:free
# - nvidia/nemotron-3-ultra-550b-a55b:free
# - nvidia/nemotron-3.5-lightning:free
# - minimax/minimax-m3:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 6. Email Provider (Resend via SMTP Relay)
# ------------------------------------------------------------------------------
# Resend provides a fast SMTP relay compatible with aiosmtplib
# Host: smtp.resend.com, Port: 465 (SSL) or 587 (TLS), Username: "resend", Password: API Key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
EMAIL_FROM=Tafiti AI <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 7. Vector Database (pgvector on Supabase / Neon PostgreSQL)
# ------------------------------------------------------------------------------
# No separate vector cluster needed! pgvector runs natively inside your PostgreSQL database.
# In Supabase/Neon, run: CREATE EXTENSION IF NOT EXISTS vector; (also automated via init_db)
VECTOR_BACKEND=pgvector
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
VECTOR_SEARCH_K=5

# ------------------------------------------------------------------------------
# 8. Storage & External Integrations
# ------------------------------------------------------------------------------
# Supabase Storage (PDF papers & thesis artifacts)
SUPABASE_URL=https://lcscppuqfrazlmueybfd.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_STORAGE_BUCKET=research-pdfs

# Academic Search APIs
OPENALEX_EMAIL=researcher@example.com
OPENALEX_API_KEY=
CORE_API_KEY=
ELSEVIER_API_KEY=
PARALLEL_API_KEY=
# Springer Nature (https://dev.springernature.com)
SPRINGER_META_API_KEY=your_springer_meta_api_key_here
SPRINGER_OPEN_ACCESS_API_KEY=your_springer_open_access_api_key_here

# Paystack (Billing & KES Payments)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing

