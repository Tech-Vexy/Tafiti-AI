# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Clerk Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Syncfusion License (free Community License available)
NEXT_PUBLIC_SYNCFUSION_LICENSE_KEY=your_syncfusion_community_license_key_here

# Feature Flags
NEXT_PUBLIC_ENABLE_SANDBOXES=true
NEXT_PUBLIC_ENABLE_BOUNTIES=true
NEXT_PUBLIC_ENABLE_DEEP_RESEARCH=true

# Environment
NEXT_PUBLIC_ENVIRONMENT=development
